{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "hello-orca",
  "publisher": "your-github-user",
  "name": "Hello Orca",
  "version": "1.0.0",
  "description": "Sample plugin combining a panel, a full page, a worker command, and event subscriptions.",
  "engines": { "orca": ">=1.4.254" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [{ "id": "hello", "title": "Hello Orca", "icon": "plug", "entry": "panel.html" }],
    "pages": [{ "id": "notes", "title": "Hello Notes", "icon": "file-text", "entry": "page.html" }],
    "commands": [
      { "id": "hello-ping", "title": "Hello: Ping" },
      { "id": "hello-open-notes", "title": "Hello: Open notes page" }
    ],
    "events": [{ "on": "workspace.created" }, { "on": "agent.status.changed" }]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "notifications:show" },
    { "kind": "storage:own" },
    { "kind": "agent:read" }
  ]
}
