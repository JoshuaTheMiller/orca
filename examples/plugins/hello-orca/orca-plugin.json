{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "hello-orca",
  "publisher": "your-github-user",
  "name": "Hello Orca",
  "version": "1.0.0",
  "description": "Sample plugin combining a panel, a full page, a worker command, sidebar nav items (a command, a toggle and a checkbox), a project item, a setting, a setting-gated sidebar card, and event subscriptions.",
  "engines": { "orca": ">=1.4.254" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [{ "id": "hello", "title": "Hello Orca", "icon": "plug", "entry": "panel.html" }],
    "pages": [{ "id": "notes", "title": "Hello Notes", "icon": "file-text", "entry": "page.html" }],
    "commands": [
      { "id": "hello-ping", "title": "Hello: Ping" },
      { "id": "hello-open-notes", "title": "Hello: Open notes page" }
    ],
    "sidebarNavItems": [
      { "id": "ping", "title": "Hello Ping", "icon": "plug", "command": "hello-ping" },
      { "id": "chatty", "title": "Chatty pings", "kind": "toggle", "setting": "chatty" },
      {
        "id": "shout",
        "title": "Shout",
        "kind": "checkbox",
        "setting": "shout",
        "parent": "chatty"
      }
    ],
    "projectItems": [{ "id": "ping", "title": "Ping", "icon": "plug", "command": "hello-ping" }],
    "settings": [
      {
        "id": "excited",
        "title": "Excited pongs",
        "description": "End each pong with exclamation marks.",
        "type": "boolean",
        "default": false
      }
    ],
    "sidebarCards": [
      {
        "id": "pings",
        "title": "Pings",
        "icon": "activity",
        "emptyText": "No pings yet.",
        "when": "excited"
      }
    ],
    "events": [
      { "on": "workspace.created" },
      { "on": "agent.status.changed" },
      { "on": "sidebarNav.valueChanged" },
      { "on": "settings.changed" },
      { "on": "sidebarCards.visibilityChanged" }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "notifications:show" },
    { "kind": "storage:own" },
    { "kind": "agent:read" },
    { "kind": "settings:own" },
    { "kind": "editor:open" }
  ]
}
